# Lanforge Environment Configuration Overrides
# Path: /etc/lanforge/lanforge.env

# Logging level (e.g. info, debug, trace, lanforge=debug)
RUST_LOG=info

# Custom configuration file path (optional)
# LANFORGE_CONFIG=/etc/lanforge/lanforge.toml

# Settings for the pull-update script (pull-update.sh)
# Build workstation host (e.g. user@workstation or IP)
# BUILD_HOST=user@workstation

# Directory where release binaries are generated on the build workstation
# BUILD_DIR=/mnt/ram/.rsbuild/release
