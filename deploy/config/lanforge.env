# Lanforge Environment Configuration Overrides
# Path: /etc/lanforge/lanforge.env

# Nível de logging (ex: info, debug, trace, lanforge=debug)
RUST_LOG=info

# Caminho customizado do arquivo de configuração (opcional)
# LANFORGE_CONFIG=/etc/lanforge/lanforge.toml

# Configurações para o utilitário de atualização (lanforge-update / pull-update.sh)
# Host da máquina de compilação (ex: user@workstation ou ip)
# BUILD_HOST=user@workstation

# Diretório onde os binários release são gerados na máquina de compilação
# BUILD_DIR=/mnt/ram/.rsbuild/release
