[Unit]
Description=lanforge — Unified IPv4/IPv6 Network Control Daemon
Documentation=https://github.com/FerrahWolfeh/lanforge
After=network.target
Wants=network.target
Before=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/lanforged --config /etc/lanforge/lanforge.toml
EnvironmentFile=-/etc/lanforge/lanforge.env

# Restart & Watchdog
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
WatchdogSec=30s
# A restart keeps the PPPoE session up: its descriptors and record wait in systemd's fd store
# (pppoe-pppox, pppoe-unit, pppoe-chan, pppoe-record). A stop closes them (after a PADT).
FileDescriptorStoreMax=4

# Permissions & Identity Model
# Runs as root for kernel operations (netlink, raw sockets, nftables, /dev/ppp), with primary
# group 'lanforge' granting local access to the control socket (/run/lanforge/control.sock).
User=root
Group=lanforge

# Linux Capabilities Hardening
# Keep only the networking capabilities and drop every other privilege.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# Systemd Directory Management (FHS)
# Creates /run/lanforge and /var/lib/lanforge with 0750 permissions (root:lanforge).
RuntimeDirectory=lanforge
RuntimeDirectoryMode=0750
# /run/lanforge (runtime database: logs, DNS query history, device observations) is kept
# across restarts and deploys; tmpfs still clears it on reboot.
RuntimeDirectoryPreserve=yes
StateDirectory=lanforge
StateDirectoryMode=0750
ConfigurationDirectory=lanforge
ConfigurationDirectoryMode=0755

# Security Hardening & VFS Sandboxing
# Mount system paths read-only except Lanforge's state, runtime, and configuration paths.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
# ProtectKernelTunables must be 'no' so the service can set interface sysctls (/proc/sys/net/...)
ProtectKernelTunables=no
ReadWritePaths=/etc/lanforge /var/lib/lanforge /run/lanforge

# Process Isolation
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=/dev/ppp rw
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
