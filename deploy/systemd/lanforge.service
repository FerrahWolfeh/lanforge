[Unit]
Description=lanforge — Unified IPv4/IPv6 Network Control Daemon
Documentation=https://github.com/FerrahWolfeh/lanforge
After=network.target
Wants=network.target
Before=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/lanforged --config /etc/lanforge/lanforge.toml
EnvironmentFile=-/etc/lanforge/lanforge.env

# Reinicialização e Watchdog
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
WatchdogSec=30s

# Modelo de Permissões e Identidade
# Executado como root para operações de kernel (netlink, raw sockets, nftables, eBPF, /dev/ppp)
# com grupo primário 'lanforge' para conceder acesso local ao socket de controle (/run/lanforge/control.sock)
User=root
Group=lanforge

# Linux Capabilities Hardening
# Mantém somente as capacidades essenciais de rede e eBPF, removendo permanentemente todas as outras.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_BPF
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_BPF

# Gerenciamento de Diretórios pelo Systemd (FHS)
# Garante a criação de /run/lanforge e /var/lib/lanforge com permissões 0750 (root:lanforge)
RuntimeDirectory=lanforge
RuntimeDirectoryMode=0750
StateDirectory=lanforge
StateDirectoryMode=0750
ConfigurationDirectory=lanforge
ConfigurationDirectoryMode=0755

# Security Hardening & VFS Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
# ProtectKernelTunables deve ser 'no' para permitir que o serviço configure sysctls de interface (/proc/sys/net/...)
ProtectKernelTunables=no
ReadWritePaths=/etc/lanforge /var/lib/lanforge /run/lanforge

# Process Isolation
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=/dev/ppp rw
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
