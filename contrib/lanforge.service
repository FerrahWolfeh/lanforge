[Unit]
Description=lanforge — Unified IPv4/IPv6 Network Control Daemon
Documentation=https://github.com/FerrahWolfeh/lanforge
After=network.target
Wants=network.target
Before=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/lanforged --config /etc/lanforge/lanforge.toml
Environment=LANFORGE_CONFIG=/etc/lanforge/lanforge.toml
EnvironmentFile=-/etc/lanforge/lanforge.env
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
WatchdogSec=30s

# Permissions & Identity Model
# Executed as root for kernel operations (netlink, raw sockets, nftables, eBPF, /dev/ppp)
# with primary group 'lanforge' granting local control socket access to group members.
User=root
Group=lanforge

# Linux Capabilities Hardening
# Retain only required networking and eBPF capabilities, dropping all other privileges.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_BPF
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_BPF

# Systemd Directory Management
# Automatically provision /run/lanforge and /var/lib/lanforge with 0750 permissions (root:lanforge).
RuntimeDirectory=lanforge
RuntimeDirectoryMode=0750
StateDirectory=lanforge
StateDirectoryMode=0750
ConfigurationDirectory=lanforge
ConfigurationDirectoryMode=0755

# Security Hardening & VFS Sandboxing
# Mount system paths as read-only except for Lanforge's state, runtime, and configuration paths.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
# ProtectKernelTunables must be 'no' to permit PPPoE interface sysctl configuration (/proc/sys/net/...)
ProtectKernelTunables=no
ReadWritePaths=/etc/lanforge /var/lib/lanforge /run/lanforge

# Process Isolation
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=/dev/ppp rw
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
