[Unit]
Description=lanforge — Unified IPv4/IPv6 Network Control Daemon
After=network-online.target pihole-FTL.service
Wants=network-online.target

[Service]
# CLI subcomando 'run' sobe todos os serviços habilitados
ExecStart=/usr/local/bin/lanforged --config /etc/lanforge/lanforge.toml
# Suporte a overrides via Env Vars se necessário
Environment=LANFORGE_CONFIG=/etc/lanforge/lanforge.toml

# Permissions & Capabilities
# Requer CAP_NET_RAW (sockets), CAP_NET_ADMIN (netlink/multicast), CAP_NET_BIND_SERVICE (portas 67/547)
User=root
Group=lanforge
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE

# Performance & Reliability
Type=notify
Restart=on-failure
RestartSec=5s
# Supervisor interno cuida das tasks, e o systemd cuida do cgroup inteiro
TimeoutStopSec=10s

# Security Hardening
# Protege o restante do sistema enquanto permite acesso aos caminhos necessários
ReadOnlyPaths=/etc/lanforge
ReadWritePaths=/run/lanforge /var/lib/lanforge /mnt/ram/dnsmasq
NoNewPrivileges=yes

RuntimeDirectory=lanforge
RuntimeDirectoryMode=0750

# Ensure the DB path matches ARCHITECTURE.md logic
# (Optional) Pre-start to sync DB from disk to RAM
ExecStartPre=/usr/bin/mkdir -p /var/lib/lanforge

[Install]
WantedBy=multi-user.target
