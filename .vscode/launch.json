{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'lanforge'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=lanforge"
                ]
            },
            "args": []
        },
        {
            "name": "Debug unit tests in executable 'lanforge'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=lanforge"
                ]
            }
        },
        {
            "name": "Debug DNS Isolated",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=lanforge"
                ]
            },
            "args": [
                "--db-path",
                "${workspaceFolder}/debug_leases.db",
                "--dns-port",
                "53535",
                "--devices-file",
                "${workspaceFolder}/debug_devices.toml",
                "--config",
                "/dev/null",
                "--control-socket",
                "/mnt/ram/sock.sock",
                "run",
                "--only",
                "dns"
            ]
        }
    ]
}