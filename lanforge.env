# Configuração de exemplo para o lanforge (Phase 1)
# O lanforge carrega estas variáveis de ambiente automaticamente (via clap).
# Útil para testar via systemd (EnvironmentFile=) ou source.

# ── RA (Router Advertisement) ────────────────────────────────────────────────
# Ativa o novo serviço de RA integrado (substituindo radvd)
LANFORGE_RA_ENABLED=true

# Interface LAN onde os RAs serão enviados em multicast (ff02::1)
LANFORGE_RA_IFACE=end0

# M flag: clientes devem usar DHCPv6 para obter endereços IPv6? 
# (true se você quiser DHCPv6 stateful, false para puro SLAAC)
LANFORGE_RA_MANAGED=true

# O flag: clientes devem usar DHCPv6 para outras configs (DNS, etc)?
LANFORGE_RA_OTHER_CONFIG=true

# MTU anunciado no RA (ex: 1492 para redes com PPPoE na WAN)
LANFORGE_RA_MTU=1492

# Prefixo ULA fixo anunciado via RA (retirado do ARCHITECTURE.md)
LANFORGE_RA_ULA_PREFIX=fd97:f00d:cafe:3731::

# Anunciar também o prefixo GUA auto-detectado da interface?
# (Isso permite que o RPi anuncie o prefixo público do provedor dinamicamente)
LANFORGE_RA_AUTO_GUA=true

# Servidor(es) DNS a anunciar via RDNSS (separados por vírgula)
LANFORGE_RA_RDNSS=fd97:f00d:cafe:3731::1


# ── SLAAC Tracker (Legado - Fase 0) ──────────────────────────────────────────
# Prefixo alvo que o tracker deve escutar os eventos Neighbor Discovery
LANFORGE_TARGET_PREFIX=fd97:f00d:cafe:3731

# Arquivo de leases v4 gerado pelo dnsmasq (para parear hostname)
LANFORGE_LEASES_FILE=/mnt/ram/dnsmasq/dnsmasq.leases

# Arquivo de hosts a ser gerado com os endereços IPv6/SLAAC encontrados
LANFORGE_OUTPUT_FILE=/mnt/ram/dnsmasq/ipv6_slaac_hosts

# Local do config onde buscar hosts estáticos (ex: dhcp-host=MAC,IP,name)
LANFORGE_DNSMASQ_CONFIG=/etc/dnsmasq-dhcp.conf

# Nome do processo para enviar SIGHUP após gerar o novo hosts file
LANFORGE_DNS_PROCESS=pihole-FTL
